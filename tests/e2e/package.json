{
  "name": "@worldinmovies/e2e",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "echo 'INFO: e2e tests require docker-compose stack. Run: pnpm e2e:up && pnpm e2e:test' && exit 0",
    "e2e:test": "playwright test",
    "e2e:up": "docker compose -f docker-compose.yml up -d",
    "e2e:down": "docker compose -f docker-compose.yml down",
    "cypress:open": "cypress open",
    "cypress:test": "cypress run",
    "playwright:open": "playwright test --ui",
    "playwright:test": "playwright test",
    "artillery:run": "artillery run --output test-results/artillery-report.json cypress/artillery/tmdb-scenarios.yml && artillery report test-results/artillery-report.json"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/node": "^24.5.2",
    "artillery": "^2.0.25",
    "cypress": "^15.3.0",
    "mongodb": "^6.20.0",
    "playwright": "^1.55.1",
    "typescript": "^5.9.2"
  }
}
