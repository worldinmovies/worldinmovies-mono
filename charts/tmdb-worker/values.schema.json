{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "secrets": {
      "type": "object",
      "description": "Secret values — real values supplied at install/upgrade time",
      "properties": {
        "DJANGO_SECRET_KEY": {
          "type": "string"
        },
        "TMDB_API_KEY": {
          "type": "string"
        },
        "SENTRY_DSN": {
          "type": "string"
        }
      },
      "required": ["DJANGO_SECRET_KEY", "TMDB_API_KEY"]
    }
  }
}
